[Unit]
Description=Touch Bar cat: a pixel cat walks across the Touch Bar while the machine is idle
After=tiny-dfr.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/touchbar-cat/touchbar_cat.py --idle 60
# If the daemon dies while the cat owns the bar, hand the bar back to tiny-dfr.
# --no-block: a blocking start from a stop hook can deadlock during shutdown.
ExecStopPost=-/usr/bin/systemctl --no-block start tiny-dfr.service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
