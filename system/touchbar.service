[Unit]
Description=better-touchbar: Touch Bar daemon for T2 MacBooks
After=systemd-user-sessions.service
# Five crashes in a minute -> give the bar back to tiny-dfr instead of leaving it dead.
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=touchbar-fallback.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/touchbar/touchbar.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
