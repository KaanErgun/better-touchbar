#!/bin/sh
# Keep the Touch Bar alive on MacBookPro16,2 (t2 kernel 7.x); runs at boot and after every resume.
#
# Boot: the appletbdrm probe sometimes times out (-110), so nothing gets the display.
#   A slow 0 -> 2 USB config reset of the Touch Bar display (05ac:8302) lets it bind.
#   Source: github.com/basecamp/omarchy/discussions/5862
# Resume: t2bce re-registers the Touch Bar DRM device and input devices; the daemon holding the
#   old card is left with a dead fd (and tiny-dfr was even stopped by its BindsTo=). Seen
#   2026-09-27: suspend 17:57, resume 18:03:53, bar dead until fixed. Restarting the owner
#   after udev has settled is the cheap, certain way back.
udevadm settle --timeout=10
reset=0
for d in /sys/bus/usb/devices/*; do
  [ "$(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)" = "05ac:8302" ] || continue
  for _ in 1 2 3 4 5; do ls -d "$d"/*/drm >/dev/null 2>&1 && break; sleep 1; done
  if ! ls -d "$d"/*/drm >/dev/null 2>&1; then
    echo 0 > "$d/bConfigurationValue"; sleep 1
    echo 2 > "$d/bConfigurationValue"; sleep 3
    reset=1
  fi
done
# The bar belongs to touchbar.service, unless it keeps failing (touchbar-fallback.service sets the
# flag) or better-touchbar is not installed: then tiny-dfr owns it.
owner=tiny-dfr.service
if systemctl is-enabled --quiet touchbar.service && [ ! -e /run/touchbar-fallback ]; then
  owner=touchbar.service
fi
systemctl restart "$owner"
echo "touchbar: reset=$reset owner=$owner $(systemctl is-active "$owner")"
